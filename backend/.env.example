# Copy to .env for local development. Never commit .env or real credentials.
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
TIMEZONE=Asia/Amman
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# PostgreSQL — local host URL and Docker-network URL must be different.
DB_HOST=localhost
DB_PORT=5432
DB_USER=omran_admin
DB_PASSWORD=CHANGE_ME_LOCAL_ONLY
DB_NAME=omran_mall_db
DATABASE_URL=postgresql://omran_admin:CHANGE_ME_LOCAL_ONLY@localhost:5432/omran_mall_db
DATABASE_URL_DOCKER=postgresql://omran_admin:CHANGE_ME_LOCAL_ONLY@omran-postgres:5432/omran_mall_db
DATABASE_SSL=false
ALLOW_DEVELOPMENT_SEEDS=true # Explicitly enables manual synthetic seeds in development only

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Generate independent random secrets locally; never reuse these examples.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_REFRESH_EXPIRATION=7d

# S3-compatible storage (optional for local phase 1)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_BUCKET_NAME=omran-mall-documents
S3_REGION=us-east-1

# Push notifications (leave unset until credentials are provisioned securely)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

DEFAULT_GEOFENCE_RADIUS_METERS=150
QR_ROTATION_INTERVAL_SECONDS=30
