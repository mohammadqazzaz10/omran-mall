# OMRAN MALL BACKEND ENVIRONMENT CONFIGURATION
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
TIMEZONE=Asia/Amman

# Database Configuration (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_USER=omran_admin
DB_PASSWORD=omran_secure_password_2026
DB_NAME=omran_mall_db
DATABASE_URL=postgresql://omran_admin:omran_secure_password_2026@localhost:5432/omran_mall_db?schema=public

# Redis Configuration (Cache, Queues, Live Breaks)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiry
JWT_SECRET=super_secret_jwt_key_omran_mall_enterprise_2026_xyz
JWT_EXPIRATION=8h
JWT_REFRESH_SECRET=refresh_secret_key_omran_mall_secure_tokens
JWT_REFRESH_EXPIRATION=30d

# Cloud Storage (S3 / MinIO Compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_access_key
S3_SECRET_KEY=minio_secret_key
S3_BUCKET_NAME=omran-mall-documents
S3_REGION=us-east-1

# Push Notifications (Firebase & Apple APNs)
FIREBASE_PROJECT_ID=omran-mall-hub
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@omran-mall-hub.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Mobile Geo-Fencing Constraints
DEFAULT_GEOFENCE_RADIUS_METERS=150
QR_ROTATION_INTERVAL_SECONDS=30
